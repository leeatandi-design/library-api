generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

enum BorrowStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  password       String
  role           Role            @default(PATRON)
  reviews        Review[]
  borrowRequests BorrowRequest[]
  bookings       Booking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id             String          @id @default(cuid())
  title          String
  author         String
  isbn           String          @unique
  publishedYear  Int
  totalCopies    Int             @default(1)
  genreId        String
  genre          Genre           @relation(fields: [genreId], references: [id])
  reviews        Review[]
  borrowRequests BorrowRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookId, userId])
}

model BorrowRequest {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status     BorrowStatus @default(PENDING)
  borrowDate DateTime     @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fineAmount Float        @default(0.0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Space {
  id          String    @id @default(cuid())
  name        String    @unique
  capacity    Int       @default(1)
  description String?
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
