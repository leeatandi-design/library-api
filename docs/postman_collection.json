{
  "info": {
    "name": "Library Management System API",
    "description": "Complete API collection for the Library Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Patron)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"name\": \"John Patron\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register (Librarian)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"name\": \"Amina Librarian\",\n  \"password\": \"password123\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('token', jsonData.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mystery\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            }
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            }
          }
        },
        {
          "name": "Get Genre by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/genres/:id",
              "host": ["{{baseUrl}}"],
              "path": ["genres", ":id"],
              "variable": [
                { "key": "id", "value": "GENRE_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Genre Name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/:id",
              "host": ["{{baseUrl}}"],
              "path": ["genres", ":id"],
              "variable": [
                { "key": "id", "value": "GENRE_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/genres/:id",
              "host": ["{{baseUrl}}"],
              "path": ["genres", ":id"],
              "variable": [
                { "key": "id", "value": "GENRE_ID_HERE" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "Get Books (with search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?search=chinua",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search", "value": "chinua" }
              ]
            }
          }
        },
        {
          "name": "Get Books (with genreId filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genreId=GENRE_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "genreId", "value": "GENRE_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Get Books (with pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books/:id",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":id"],
              "variable": [
                { "key": "id", "value": "BOOK_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Create Book (Requires LIBRARIAN token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Book Title\",\n  \"author\": \"Author Name\",\n  \"isbn\": \"978-0000000001\",\n  \"publishedYear\": 2024,\n  \"totalCopies\": 5,\n  \"genreId\": \"GENRE_ID_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "Update Book (Requires LIBRARIAN token)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Book Title\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/:id",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":id"],
              "variable": [
                { "key": "id", "value": "BOOK_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Delete Book (Requires LIBRARIAN token)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/:id",
              "host": ["{{baseUrl}}"],
              "path": ["books", ":id"],
              "variable": [
                { "key": "id", "value": "BOOK_ID_HERE" }
              ]
            }
          }
        }
      ]
    }
  ]
}
